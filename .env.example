# Copy this file to .env and fill in real values. Never commit .env.
# PostgreSQL (local Docker Compose)
POSTGRES_DB=school_management
POSTGRES_USER=sms_user
POSTGRES_PASSWORD=change-me-strong-postgres-password

# Backend (FastAPI) - set real values in .env
DATABASE_URL=postgresql+asyncpg://sms_user:change-me-strong-postgres-password@postgres:5432/school_management
JWT_SECRET_KEY=change-me-64-hex-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000